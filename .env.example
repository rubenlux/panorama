# Panorama News Platform — environment variables
# Copy to .env and fill in real values. Never commit the real .env file.

# ── Core (required) ──────────────────────────────────────────────────────────
PORT=5000
DATABASE_URL=postgres://postgres:postgres@127.0.0.1:5435/newsdb
JWT_SECRET=change-me-to-a-long-random-string
JWT_EXPIRES_IN=7d

# ── Analytics (src/routes/analytics_v2.js) ───────────────────────────────────
# Comma-separated hostnames this site is served from, beyond localhost/127.0.0.1
# (always included by default). Used so internal navigation and dev/test traffic
# never get misclassified as an external traffic-acquisition source. Set this
# once there's a real production domain, e.g. PUBLIC_SITE_HOSTNAMES=panorama.news
PUBLIC_SITE_HOSTNAMES=

# ── AI providers ──────────────────────────────────────────────────────────────
ANTHROPIC_API_KEY=
OPENAI_API_KEY=

# ── MCP server (mcp-server/src/index.js) ─────────────────────────────────────
# Service-account auth for MCP tool calls against the API.
MCP_SERVICE_TOKEN=
MCP_SERVICE_USER_ID=
# Base URL the MCP server calls back into the API on (defaults to localhost:5000).
BACKEND_URL=http://localhost:5000
# Attributed as created_by when the MCP service account creates content.
PANORAMA_USER_ID=

# ── Social Intelligence — Facebook / Instagram ───────────────────────────────
# See memory/bug_001_facebook_graphql_fix.md for the cookie-renewal runbook.
FB_API_VERSION=v19.0
FB_PAGE_ACCESS_TOKEN=
FB_COOKIES_FILE=facebook_cookies.json
FB_PROFILE_DIR=facebook-profile
IG_COOKIES_FILE=instagram_cookies.json

# ── Social Intelligence — X / Twitter (disabled by default) ──────────────────
ENABLE_X_MONITOR=false
# auth_token / ct0 cookies from a logged-in x.com session (DevTools > Application > Cookies).
X_AUTH_TOKEN=
X_CT0=

# ── Social Intelligence — general ────────────────────────────────────────────
SOCIAL_MAX_CONCURRENCY=3
YOUTUBE_API_KEY=

# ── Transcripts (src/connectors/social/transcripts.js) ───────────────────────
# playwright (default, active) | legacy | disabled
TRANSCRIPT_PROVIDER=playwright
# 0 = unlimited. Admin role always bypasses this limit.
TRANSCRIPT_DAILY_LIMIT=10

# ── Coverage monitor ──────────────────────────────────────────────────────────
COVERAGE_CONTENT_BATCH=20

# ── Browser pool (src/jobs/newsMonitor/playwright/BrowserPool.js) ───────────
BROWSER_POOL_MAX_BROWSERS=3

# ── Debug flags (unset/false in production) ──────────────────────────────────
MONITOR_SQL_DEBUG=0
OPENCLAW_DEBUG=0

# ── Misc ──────────────────────────────────────────────────────────────────────
CONTACT_EMAIL=
PEXELS_API_KEY=

# ── Outgoing email (SMTP) ─────────────────────────────────────────────────────
SMTP_HOST=
SMTP_PORT=587
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
